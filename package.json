{
  "name": "arncode",
  "version": "0.1.0",
  "description": "A Claude coding agent with full access by default, a multi-account credential bank, automatic failover, and skills loaded on demand.",
  "type": "module",
  "bin": {
    "arncode": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.0",
    "diff": "^8.0.0",
    "fast-glob": "^3.3.3",
    "jpeg-js": "^0.4.4",
    "picocolors": "^1.1.1",
    "pngjs": "^7.0.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "claude",
    "anthropic",
    "credential-bank",
    "multi-account",
    "automatic-failover",
    "oauth",
    "full-access",
    "skills",
    "prompt-caching"
  ]
}
