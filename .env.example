# Multi-account credential bank: use `arncode creds add` for stored accounts.
# Environment credentials are optional fallbacks.
# Replace a value locally; never commit credentials.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Optional settings. ArnCode does not automatically load .env files.
# ARNCODE_CONFIG_DIR=/path/outside/repositories/arncode-state
# ARNCODE_AUTH=api-key
# ARNCODE_PROFILE=credential_name
# ARNCODE_MODEL=model_id
# ANTHROPIC_BASE_URL=https://api.example.com
# ARNCODE_EFFORT=medium
# ARNCODE_FAST=false
# ARNCODE_MAX_TOKENS=64000
# ARNCODE_MAX_TURNS=80

# Tools have full access by default.
# Use --safe / --ask, or set permissionMode to "ask" in config.json, for approvals.
